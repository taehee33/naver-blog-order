{
  "manifest_version": 3,
  "name": "네이버 블로그 사진(파일) 업로드 순서 유지 +회전(AI)",
  "version": "1.3.0",
  "description": "네이버 블로그에 사진·파일을 정렬된 순서대로 올리고, 누운 사진은 AI가 찾아 네이버 편집기로 돌려줍니다. 원본 파일은 그대로예요.",
  "permissions": [
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "정렬·회전 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://m.blog.naver.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://m.blog.naver.com/*"
      ],
      "js": [
        "sorter.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ]
}
